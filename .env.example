# Database
DATABASE_URL=postgresql://user:password@localhost:5432/mtc_internal
# Used by the test suite (vitest) instead of DATABASE_URL
DEV_DATABASE_URL=postgresql://user:password@localhost:5432/mtc_internal_dev

# Auth — generate with: openssl rand -base64 32
JWT_SECRET=

# Storefront MongoDB (web orders and carts), read-only. Same value as mtc-dashboard.
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/mtc
